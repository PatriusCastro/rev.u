  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types --no-warnings tests/*.test.ts",
    "check:content": "node --experimental-strip-types --no-warnings scripts/import.ts --check",
    "import": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings scripts/import.ts",
    "check:rls": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings scripts/rls-check.ts",
    "test:e2e": "node tests/e2e/uat.mjs && node tests/e2e/features.mjs",
    "check:repeats": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings scripts/repeat-check.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
